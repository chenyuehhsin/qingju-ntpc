            "required": [
              "metric",
              "operator"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true
        },
        "minimum_reliability": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
