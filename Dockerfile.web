FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Keep all application assets in a single layer. CloudShell uses the VFS
# Docker driver, where one layer per directory can exhaust its small disk.
COPY app assets data outputs knowledge_base ./

EXPOSE 8501

# App Runner injects PORT. Streamlit listens on all interfaces so its health
# endpoint and public service URL reach the app process.
CMD ["sh", "-c", "streamlit run app/app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true"]
